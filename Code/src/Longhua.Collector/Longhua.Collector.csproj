<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Longhua.Collector</RootNamespace>
    <AssemblyName>Longhua.Collector</AssemblyName>
    <Description>龙华立库数据采集：MQTT 一期，S7 预留</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="6.0.2" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\appsettings.json" Link="config\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\catalog.json" Link="config\catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\appsettings.Local.json.example" Link="config\appsettings.Local.json.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
